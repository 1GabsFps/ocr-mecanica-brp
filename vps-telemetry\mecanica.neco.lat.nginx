server {
    server_name mecaninca.neco.lat mecanica.neco.lat;

    root /home/ubuntu/MECBRP;
    index index.html;
    charset utf-8;

    include /etc/nginx/mime.types;
    default_type text/html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    # Proxy reverso para o microsserviço de telemetria Docker (Porta 8002)
    location /api/telemetry {
        proxy_pass http://127.0.0.1:8002;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ~* \.(?:css|js)$ {
        try_files $uri =404;
        expires 1y;
        access_log off;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location ~* \.(?:ico|png|jpg|jpeg|gif|svg|woff|woff2|ttf|wasm|traineddata)$ {
        try_files $uri =404;
        expires 1y;
        access_log off;
    }

    listen [::]:443 ssl ipv6only=on;
    listen 443 ssl;
    ssl_certificate /etc/letsencrypt/live/mecanica.neco.lat/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/mecanica.neco.lat/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
}

server {
    if ($host = mecanica.neco.lat) {
        return 301 https://$host$request_uri;
    }

    listen 80;
    listen [::]:80;
    server_name mecaninca.neco.lat mecanica.neco.lat;
    return 404;
}
