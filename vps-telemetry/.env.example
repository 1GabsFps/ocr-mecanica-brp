# ==========================================
# Configuração de Ambiente — Mecânica BRP Backend
# ==========================================

# Caminho do Banco de Dados SQLite (WAL Mode)
DB_PATH=/app/data/telemetry.db

# Senha Administrativa (usada para acesso aos endpoints protegidos)
ADMIN_SECRET=adicione_sua_senha_forte_aqui

# Steam Web API Key (obtenha em https://steamcommunity.com/dev/apikey)
STEAM_API_KEY=adicione_sua_steam_api_key_aqui

# Integração Externa (Netlify / Sincronização)
NETLIFY_API_URL=https://mecanica.gbrdev.net/api/funcionarios
NETLIFY_API_KEY=adicione_sua_api_key_aqui

# URL Base da Aplicação Frontend
APP_BASE_URL=https://mecanica.gbrdev.net

# Webhook do Discord para Notificações e Faturas
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/SEU_CANAL/SEU_TOKEN

# Portas de Execução
PORT=8002
