server {
    server_name mecanica.neco.lat mecaninca.neco.lat;

    root /home/ubuntu/MECBRP;
    index index.html;
    charset utf-8;

    include /etc/nginx/mime.types;
    default_type text/html;

    # Tipos MIME especiais para Tesseract WASM e modelos locais
    types {
        application/wasm wasm;
        application/octet-stream traineddata;
    }

    # Compressao Gzip de Alta Velocidade
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_types text/plain text/css text/xml text/javascript application/x-javascript application/xml application/javascript application/json application/wasm image/svg+xml;
    gzip_disable "MSIE [1-6]\.";

    # Headers de Seguranca & HSTS
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Evita cache para HTML e checagem de versao (Garante auto-update instantaneo)
    location = /index.html {
        add_header Cache-Control "no-cache, no-store, must-revalidate, max-age=0";
        add_header Pragma "no-cache";
        add_header Expires "0";
    }

    location = /version.json {
        add_header Cache-Control "no-cache, no-store, must-revalidate, max-age=0";
        add_header Pragma "no-cache";
        add_header Expires "0";
    }

    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache, no-store, must-revalidate, max-age=0";
    }

    # Proxy reverso para o microsservico de telemetria Docker (Porta 8002)
    location /api/telemetry {
        proxy_pass http://127.0.0.1:8002;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Chunks imutaveis do Vite (com hash no nome) podem ter cache longo
    location ~* \.(?:css|js)$ {
        try_files $uri =404;
        expires 1y;
        access_log off;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location ~* \.(?:ico|png|jpg|jpeg|gif|svg|woff|woff2|ttf|wasm|traineddata)$ {
        try_files $uri =404;
        expires 1y;
        access_log off;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    listen [::]:443 ssl ipv6only=on;
    listen 443 ssl;
    ssl_certificate /etc/letsencrypt/live/mecanica.neco.lat/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/mecanica.neco.lat/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
}

# Redirecionamento HTTP -> HTTPS Padronizado (Sem 'if')
server {
    listen 80;
    listen [::]:80;
    server_name mecanica.neco.lat mecaninca.neco.lat;
    return 301 https://$host$request_uri;
}
