# Rate limit para o painel de administracao
limit_req_zone $binary_remote_addr zone=mec_admin_limit:10m rate=5r/m;

# Servidor Principal HTTPS: mecanica.gbrdev.net
server {
    server_name mecanica.gbrdev.net;

    root /home/ubuntu/MECBRP;
    index index.html;
    charset utf-8;
    client_max_body_size 25M;

    include /etc/nginx/mime.types;
    default_type text/html;

    # Tipos MIME especiais para Tesseract WASM e modelos locais
    types {
        application/wasm wasm;
        application/octet-stream traineddata;
    }

    # Compressao Gzip de Alta Velocidade
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_types text/plain text/css text/xml text/javascript application/x-javascript application/xml application/javascript application/json application/wasm image/svg+xml;
    gzip_disable "MSIE [1-6].";

    # Headers de Seguranca & HSTS
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Evita cache para HTML e checagem de versao (Garante auto-update instantaneo)
    location = /index.html {
        add_header Cache-Control "no-cache, no-store, must-revalidate, max-age=0";
        add_header Pragma "no-cache";
        add_header Expires "0";
    }

    location = /version.json {
        add_header Cache-Control "no-cache, no-store, must-revalidate, max-age=0";
        add_header Pragma "no-cache";
        add_header Expires "0";
    }

    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache, no-store, must-revalidate, max-age=0";
    }

    # Proxy reverso para o microsservico de telemetria, auth e proxy do Discord (Porta 8002)
    location /api/telemetry {
        proxy_pass http://127.0.0.1:8002;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 25M;
    }

    # Proxy reverso para Google Gemini com Keep-Alive persistente e baixa latencia
    location /api/gemini-ai/ {
        proxy_pass https://generativelanguage.googleapis.com/;
        proxy_ssl_server_name on;
        proxy_set_header Host "generativelanguage.googleapis.com";
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_read_timeout 15s;
        proxy_connect_timeout 5s;
        client_max_body_size 10M;
    }

    # Proxy reverso para Cloudflare Workers AI (Com injecao server-side do Token)
    location /api/cloudflare-ai/ {
        proxy_pass https://api.cloudflare.com/client/v4/accounts/5662e82e2101cdb59a1351361b9c4dbd/ai/run/;
        proxy_ssl_server_name on;
        proxy_set_header Host "api.cloudflare.com";
        proxy_set_header Authorization "Bearer cfut_Er2FS7dLJ9XC2yWlfASdvfqe6CLQvcr7yRGsCg6Yc6e1039e";
        proxy_set_header Content-Type "application/json";
        proxy_read_timeout 30s;
        proxy_connect_timeout 10s;
        client_max_body_size 10M;
    }

    # Chunks imutaveis do Vite (com hash no nome) podem ter cache longo
    location ~* .(?:css|js)$ {
        try_files $uri =404;
        expires 1y;
        access_log off;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location ~* .(?:ico|png|jpg|jpeg|gif|svg|woff|woff2|ttf|wasm|traineddata)$ {
        try_files $uri =404;
        expires 1y;
        access_log off;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    listen [::]:443 ssl;
    listen 443 ssl;
    ssl_certificate /etc/letsencrypt/live/mecanica.gbrdev.net/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/mecanica.gbrdev.net/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
}

# Redirecionamento HTTPS 301 Permanente: mecanica.neco.lat -> mecanica.gbrdev.net
server {
    listen [::]:443 ssl;
    listen 443 ssl;
    server_name mecanica.neco.lat mecaninca.neco.lat;
    ssl_certificate /etc/letsencrypt/live/mecanica.neco.lat/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/mecanica.neco.lat/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    return 301 https://mecanica.gbrdev.net$request_uri;
}

# Redirecionamento HTTP -> HTTPS Padronizado (Todos os dominios)
server {
    listen 80;
    listen [::]:80;
    server_name mecanica.gbrdev.net mecanica.neco.lat mecaninca.neco.lat;
    return 301 https://mecanica.gbrdev.net$request_uri;
}
